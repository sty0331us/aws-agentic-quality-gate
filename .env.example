# --- Core ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ENVIRONMENT=dev

# --- Evaluation ---
EVAL_MODE=offline
JUDGE_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
EVAL_BACKEND=native
SHARD_SIZE=8
SQS_WAIT_SECONDS=20
MAX_CASES_PER_WORKER=64

# --- Thresholds (0-1). Aggregator fails the PR if any metric mean is below these. ---
THRESHOLD_FAITHFULNESS=0.70
THRESHOLD_ANSWER_RELEVANCE=0.70
THRESHOLD_TOOL_SELECTION_PRECISION=0.80
THRESHOLD_MIN_PASS_RATE=0.85
THRESHOLD_MAX_ERROR_RATE=0.05

# --- Agent under test (online mode) ---
AGENT_ENDPOINT=
AGENT_API_KEY=

# --- GitHub gate ---
GITHUB_REPO=org/aws-agentic-quality-gate
GITHUB_TOKEN=

# --- Local / dry-run ---
BEDROCK_ENABLED=false
LOG_LEVEL=INFO
