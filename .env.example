# --- Core ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ENVIRONMENT=dev

# --- Evaluation ---
EVAL_MODE=candidate
JUDGE_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
CANDIDATE_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
EVAL_BACKEND=deepeval
COMPUTE_BACKEND=ecs
SHARD_SIZE=8
SQS_WAIT_SECONDS=20
MAX_CASES_PER_WORKER=64

# --- Gate: overall score >= 0.85 blocks merge on failure ---
THRESHOLD_OVERALL=0.85
THRESHOLD_FAITHFULNESS=0.85
THRESHOLD_ANSWER_RELEVANCE=0.85
THRESHOLD_TOOL_SELECTION_PRECISION=0.85
THRESHOLD_MIN_PASS_RATE=0.85
THRESHOLD_MAX_ERROR_RATE=0.05

# --- Agent under test ---
AGENT_ENDPOINT=
AGENT_API_KEY=

# --- GitHub + Slack ---
GITHUB_REPO=org/aws-agentic-quality-gate
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=

# --- Local / dry-run ---
BEDROCK_ENABLED=false
LOG_LEVEL=INFO
